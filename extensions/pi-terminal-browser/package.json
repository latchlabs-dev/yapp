{
  "name": "@earlgrey/pi-terminal-browser",
  "version": "0.1.0",
  "description": "Pi-native, explicitly authorized control of browser-hosted TTY terminals through a paired Chrome extension.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "chrome-extension",
    "browser-automation",
    "terminal",
    "xterm",
    "web-ssh",
    "cdp"
  ],
  "files": [
    "src",
    "chrome-extension",
    "skills",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.3",
    "typebox": ">=1.3.19"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.8.3",
    "typebox": "1.3.19"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/tests/*.test.js"
  }
}
