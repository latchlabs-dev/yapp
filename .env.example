# PROXY_SERVER_PUBLIC_ADDR=:8080
# PROXY_SERVER_ADMIN_ADDR=:8081
# PROXY_SERVER_METRICS_ADDR=:9090
# PROXY_SERVER_MAX_BODY_BYTES=20971520
# PROXY_SERVER_REQUEST_TIMEOUT=10m
# PROXY_SERVER_SHUTDOWN_TIMEOUT=30s

# Postgres
# PROXY_POSTGRES_DSN=postgres://proxy:proxy@localhost:5432/proxy?sslmode=disable
# Production runtime uses PgBouncer on 6432; maintenance/migrations use 5432.
# PROXY_POSTGRES_DIRECT_DSN=postgres://proxy:proxy@localhost:5432/proxy?sslmode=disable
# PROXY_POSTGRES_MAX_OPEN_CONNS=25
# PROXY_POSTGRES_MAX_IDLE_CONNS=0

# Redis
# PROXY_REDIS_ADDRESS=localhost:6379
# PROXY_REDIS_PASSWORD=
# PROXY_REDIS_DB=0
# PROXY_REDIS_TLS=false

# Secrets
# PROXY_SECRETS_PROVIDER=env
# PROXY_SECRETS_ADDRESS=
# PROXY_SECRETS_TOKEN=
# PROXY_SECRETS_ENV_PREFIX=PROXY_SECRET_
# Generate with: openssl rand -base64 32
# PROXY_CREDENTIAL_ENCRYPTION_KEY=

# Auth
# PROXY_AUTH_KEY_PREFIX=cpk_live_
# PROXY_AUTH_HASH_PEPPER_REF=

# Metrics
# PROXY_METRICS_ENABLED=true

# Logging
# PROXY_LOGGING_LEVEL=info
# PROXY_LOGGING_FORMAT=json
# PROXY_LOGGING_LOG_BODIES=false

# Quota
# PROXY_QUOTA_RESERVATION_TTL=15m

# Raw conversation capture
# PROXY_CAPTURE_ENABLED=true
# PROXY_CAPTURE_BACKEND=postgres
# PROXY_CAPTURE_RETENTION_DAYS=30
# PROXY_CAPTURE_QUEUE_SIZE=1000
# 0 = never truncate captures (default; keeps sessions replayable).
# A value > 0 caps bodies and records capture_gaps markers for the loss.
# PROXY_CAPTURE_MAX_PAYLOAD_BYTES=0
# PROXY_CAPTURE_STRICT=false

# Optional IP abuse guard; 0 disables request-rate limiting.
# PROXY_RATELIMIT_REQUESTS_PER_MINUTE=0

# Metadata hook persistence. Empty events_file disables the built-in sink.
# PROXY_HOOKS_EVENTS_FILE=/var/lib/piproxy/hooks/events.jsonl
# Optional external webhook delivery remains available for integrations.
# PROXY_HOOKS_WEBHOOK_URL=https://hooks.example.com/piproxy
# PROXY_HOOKS_WEBHOOK_SECRET=

# External project-insight generation. The master switch and tenant consent
# remain fail-closed; gRPC services, scopes, instructions, and tags are managed
# on the Insights page in the admin UI.
# PROXY_DUFFEL_ROOT=/var/lib/piproxy/memory
# PROXY_MEMORY_INJECTION_ENABLED=false
# PROXY_INSIGHTS_ENABLED=true
# PROXY_MEMORY_DISTILLATION_QUEUE_NAME=memory_distillation
# PROXY_MEMORY_DISTILLATION_NIGHTLY_AT_UTC=23:00
# PROXY_MEMORY_DISTILLER_IDLE=15m
# PROXY_MEMORY_DISTILLATION_WORKERS=1
# PROXY_MEMORY_COMPACTION_ENABLED=true
# PROXY_MEMORY_COMPACTION_MAX_TOKENS=1200
# PROXY_MEMORY_COMPACTION_PEAK_WINDOWS_UTC=01:00-04:00,06:00-10:00

# Providers
# PROXY_PROVIDERS_REFRESH_INTERVAL=30s

# Admin API key (required for admin server)
# PROXY_ADMIN_KEY=adm_use-a-strong-random-key-here

# ---- Tailscale-only web portal (/web/v1 + the piproxy-webui container) ----
# Off by default. Production webui binds TAILSCALE_BIND_IP only, and the
# public edge denies /web. Use a tailnet-only HTTPS hostname for this URL
# and the OIDC callback; never enable Tailscale Funnel for the portal.
# Key login uses existing personal proxy keys (not PROXY_ADMIN_KEY).
# Key cookies are encrypted with PROXY_CREDENTIAL_ENCRYPTION_KEY, HttpOnly,
# Secure and host-only (__Host-piproxy_web_session, Path=/). Revocation/scopes
# are checked on every request. PROXY_WEB_COOKIE_DOMAIN must stay unset.
# PROXY_WEB_ENABLED=false
# PROXY_WEB_API_KEY_LOGIN=true
# PROXY_WEB_BASE_URL=https://console.example.com
# OIDC is optional; if any OIDC fields are set, the full triple is required.
# PROXY_WEB_OIDC_ISSUER=https://auth.example.com
# PROXY_WEB_OIDC_CLIENT_ID=
# PROXY_WEB_OIDC_CLIENT_SECRET=
# PROXY_WEB_OIDC_REDIRECT_URL=https://console.example.com/web/v1/auth/callback
# PROXY_WEB_OIDC_PROVIDER_NAME=your work account
# PROXY_WEB_SESSION_TTL=12h
# PROXY_WEB_SESSION_IDLE_TTL=2h
# Only for loopback http:// development (separate *_dev cookie names);
# production always serves over TLS and never accepts development cookies.
# PROXY_WEB_COOKIE_INSECURE=false

# Attachments live in GCS and are uploaded straight from the browser via signed
# URLs. On Workload Identity the runtime service account needs
# roles/iam.serviceAccountTokenCreator ON ITSELF for signing to work, plus
# object access on the bucket.
# PROXY_WEB_ATTACHMENTS_BUCKET=
# PROXY_WEB_ATTACHMENTS_PREFIX=attachments
# PROXY_WEB_ATTACHMENT_MAX_BYTES=26214400
# PROXY_WEB_ATTACHMENT_RETENTION_DAYS=90
# Caps per-user console writes (messages, conversations, uploads) per minute.
# The user message is persisted before the model call checks quota, so this is
# what bounds database growth from denied or abusive turns. 0 disables it.
# PROXY_WEB_WRITE_REQUESTS_PER_MINUTE=60

# ---- Database-managed hook subscriptions ----
# Off by default: blocking hooks add latency to every matching request,
# including existing CLI traffic. Roll out per tenant.
# PROXY_HOOKS_SUBSCRIPTIONS_ENABLED=false
# PROXY_HOOKS_REFRESH_INTERVAL=30s
# Total budget across ALL blocking hooks on one request, not per hook.
# PROXY_HOOKS_BLOCKING_BUDGET=3s
# Dev/live-test only. Leaving this on in production makes the hook registry an
# SSRF primitive.
# PROXY_HOOKS_ALLOW_PRIVATE_EGRESS=false
# PROXY_HOOKS_DELIVERY_RETENTION_DAYS=14

# Public base URL for generating Pi onboarding instructions
# Set this to the public-facing URL of your proxy (e.g., https://llm-gateway.example.com)
# PROXY_PUBLIC_BASE_URL=https://llm-gateway.example.com

# ---- Secret examples (for development) ----
# PROXY_SECRET_PROXY_KEY_HASH_PEPPER=dev-pepper-not-for-production
# PROXY_SECRET_PROXY_OPENAI_KEY=sk-dev-openai-key
# PROXY_SECRET_PROXY_ANTHROPIC_KEY=sk-dev-anthropic-key
# PROXY_SECRET_PROVIDERS_DEEPSEEK_API_KEY=sk-dev-deepseek-key

# ---- Optional DuckDB / Parquet session reader ----
# Admin retains PostgreSQL ownership/snapshot checks and falls back to the
# source transcript when the service is unavailable or not caught up.
# PROXY_SESSION_QUERY_URL=http://session-query:8092
# PROXY_SESSION_QUERY_TOKEN=<dedicated random token of at least 32 characters>
# PROXY_SESSION_QUERY_TIMEOUT=750ms
# SESSION_QUERY_POSTGRES_DSN=<dedicated read-only PostgreSQL DSN>
# SESSION_QUERY_PARQUET_PREFIX=session-parquet/v1
# PIPROXY_SESSION_QUERY_VERSION=<exact service image tag>

# ---- Model guards ----
# Stop requests for specific models with a custom, user-facing error message
# Unset or "[]" permits all configured models. Set a JSON array to enforce
# your instance policy. Invalid JSON fails startup.
# Each rule: {"model":"name-or-prefix*","message":"user-facing text",
#             "error_type":"model_blocked","tenant_id":"optional-scope"}
# PROXY_MODEL_GUARDS=[{"model":"retired-model","message":"This model has been retired; choose another configured model."}]
